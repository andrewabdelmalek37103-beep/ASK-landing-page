# Base site URL used for canonical links, Open Graph tags, and the sitemap.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Booking provider integration.
# NEXT_PUBLIC_BOOKING_PROVIDER: one of "tidycal" | "calendly" | "cal.com" | "zcal"
# NEXT_PUBLIC_BOOKING_URL: the full booking page URL for your chosen provider
#   (e.g. https://tidycal.com/your-handle/ai-growth-audit).
NEXT_PUBLIC_BOOKING_PROVIDER=tidycal
NEXT_PUBLIC_BOOKING_URL=

# Contact details shown in the footer. Leave blank to hide the corresponding link.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_URL=

# Analytics providers. Each is optional and no-ops when left blank.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# Server-only webhook that receives lead form submissions (Opportunity Finder,
# ROI calculator, lead capture form). Never expose this to the client.
LEAD_WEBHOOK_URL=
